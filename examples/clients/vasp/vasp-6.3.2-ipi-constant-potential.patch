+      SUBROUTINE READ_IPI_INIT
+      INTEGER :: INIT_RID, INITLEN, INIT_PARSE_STATUS
+      CHARACTER(LEN=:), ALLOCATABLE :: INITSTR
+      LOGICAL :: FOUND_NELECT, FOUND_NEUTRAL, FOUND_AXIS
+      LOGICAL :: FOUND_AVERAGE_MIN, FOUND_AVERAGE_MAX, TOKEN_OK
+      ! receives initialization string and parses NELECT for constant potential mode
+      IF (COMM%NODE_ME == 1) THEN
+        CALL readbuffer(SOCKET, INIT_RID)
+        CALL readbuffer(SOCKET, INITLEN)
+        INIT_PARSE_STATUS = 1
+        NEUTRAL_ELECTRONS_REF = 0._q
+        POTENTIAL_AVERAGE_AXIS = 0
+        POTENTIAL_AVERAGE_MIN_A = 0._q
+        POTENTIAL_AVERAGE_MAX_A = 0._q
+        FOUND_NELECT = .FALSE.
+        FOUND_NEUTRAL = .FALSE.
+        FOUND_AXIS = .FALSE.
+        FOUND_AVERAGE_MIN = .FALSE.
+        FOUND_AVERAGE_MAX = .FALSE.
+
+        IF (INITLEN<=0) THEN
+          INIT_PARSE_STATUS = 0
+        ELSE
+          ALLOCATE(CHARACTER(LEN=INITLEN) :: INITSTR)
+          CALL readbuffer(SOCKET, INITSTR, INITLEN)
+          CALL PARSE_IPI_REAL_TOKEN(INITSTR,'NELECT',INFO%NELECT,FOUND_NELECT,TOKEN_OK)
+          IF (.NOT. TOKEN_OK) INIT_PARSE_STATUS = 0
+          CALL PARSE_IPI_REAL_TOKEN(INITSTR,'neutral_electrons',NEUTRAL_ELECTRONS_REF,FOUND_NEUTRAL,TOKEN_OK)
+          IF (.NOT. TOKEN_OK) INIT_PARSE_STATUS = 0
+          CALL PARSE_IPI_AXIS_TOKEN(INITSTR,'potential_average_axis', &
+     &             POTENTIAL_AVERAGE_AXIS,FOUND_AXIS,TOKEN_OK)
+          IF (.NOT. TOKEN_OK) INIT_PARSE_STATUS = 0
+          CALL PARSE_IPI_REAL_TOKEN(INITSTR,'potential_average_min_A', &
+     &             POTENTIAL_AVERAGE_MIN_A,FOUND_AVERAGE_MIN,TOKEN_OK)
+          IF (.NOT. TOKEN_OK) INIT_PARSE_STATUS = 0
+          CALL PARSE_IPI_REAL_TOKEN(INITSTR,'potential_average_max_A', &
+     &             POTENTIAL_AVERAGE_MAX_A,FOUND_AVERAGE_MAX,TOKEN_OK)
+          IF (.NOT. TOKEN_OK) INIT_PARSE_STATUS = 0
+          IF (INDEX(INITSTR,'solvation_update_stride')>0) THEN
+            WRITE(TIU0,*) 'ERROR: INIT solvation_update_stride has been removed.'
+            INIT_PARSE_STATUS = 0
+          ENDIF
+          DEALLOCATE(INITSTR)
+        ENDIF
+
+        IF (.NOT. FOUND_NELECT .OR. INFO%NELECT<=0._q) INIT_PARSE_STATUS = 0
+        IF (FOUND_NEUTRAL .AND. NEUTRAL_ELECTRONS_REF<=0._q) INIT_PARSE_STATUS = 0
+        IF ((FOUND_AXIS .NEQV. FOUND_AVERAGE_MIN) .OR. &
+     &          (FOUND_AXIS .NEQV. FOUND_AVERAGE_MAX)) INIT_PARSE_STATUS = 0
+        IF (FOUND_AXIS .AND. (POTENTIAL_AVERAGE_AXIS<1 .OR. POTENTIAL_AVERAGE_AXIS>3)) &
+     &          INIT_PARSE_STATUS = 0
+        IF (FOUND_AVERAGE_MIN .AND. POTENTIAL_AVERAGE_MAX_A<=POTENTIAL_AVERAGE_MIN_A) &
+     &          INIT_PARSE_STATUS = 0
+        IF (INIT_PARSE_STATUS==1) THEN
+          WRITE(TIU0,*) ' @ DRIVER MODE: Parsed NELECT from INIT for IBRION=24: ', INFO%NELECT
+          IF (FOUND_NEUTRAL) &
+     &          WRITE(TIU0,*) ' @ DRIVER MODE: Parsed neutral_electrons from INIT: ', NEUTRAL_ELECTRONS_REF
+          IF (FOUND_AXIS) &
+     &          WRITE(TIU0,*) ' @ DRIVER MODE: Parsed potential average axis/region: ', &
+     &          POTENTIAL_AVERAGE_AXIS, POTENTIAL_AVERAGE_MIN_A, POTENTIAL_AVERAGE_MAX_A
+        ENDIF
