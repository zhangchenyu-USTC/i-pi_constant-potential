+! The frozen solvent is an external field: keep its net force on the ions.
+LOGICAL FUNCTION SOL_IS_FROZEN()
+ SOL_IS_FROZEN = LSOL .AND. SOL_UPDATE>1 .AND. SOL_PENDING .AND. &
+                 SOL_CACHE_VALID .AND. .NOT.SOL_REFRESH
+END FUNCTION SOL_IS_FROZEN
+
+! Keep the solvent net charge consistent with the current ionic valences.
+SUBROUTINE SOL_UPDATE_ZVSUM(T_INFO, P)
+ USE pseudo, ONLY : potcar
+ TYPE(type_info), INTENT(IN) :: T_INFO
+ TYPE(potcar), INTENT(IN) :: P(T_INFO%NTYP)
+ INTEGER :: NT
+ ZVSUM = 0._q
+ DO NT = 1,T_INFO%NTYP
+   ZVSUM = ZVSUM + P(NT)%ZVALF * T_INFO%NITYP(NT) * T_INFO%VCA(NT)
+ ENDDO
+ ! The updated ions start a new SCF problem, with no previous residual.
+ rms_SCF = 0._q
+END SUBROUTINE SOL_UPDATE_ZVSUM
+
+! One local phase per completed POSDATA evaluation, independent of CHGDATA.
+SUBROUTINE SOL_RESET_DRIVER
+ SOL_PHASE = 0
+ SOL_EVALUATIONS = 0
+ SOL_CACHE_VALID = .FALSE.
+ SOL_PENDING = .FALSE.
+END SUBROUTINE SOL_RESET_DRIVER
+
+SUBROUTINE SOL_VALIDATE_DRIVER(IBRION)
+ INTEGER, INTENT(IN) :: IBRION
+ IF (SOL_UPDATE > 1) THEN
+   IF (IBRION /= 24 .OR. .NOT.LSOL .OR. .NOT.LSOL_SCF) THEN
+     IF (IU0>=0) WRITE(IU0,*) 'ERROR: SOL_UPDATE>1 requires IBRION=24, LSOL and LSOL_SCF.'
+     CALL vtutor%stopCode(isError)
+   ENDIF
+ ENDIF
+END SUBROUTINE SOL_VALIDATE_DRIVER
+
+SUBROUTINE SOL_BEGIN_DRIVER(GRID, LATTICE)
+ TYPE(grid_3d), INTENT(IN) :: GRID
