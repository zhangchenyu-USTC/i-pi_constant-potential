+      IPI_RESULT_VALID=.FALSE.
+      IPI_OBSERVABLES_READY=.FALSE.
+      END SUBROUTINE READ_IPI_INIT
+
+      SUBROUTINE READ_IPI_CHARGE
+      INTEGER :: IPI_MODE_FLAGS, NE_DOPING_FLAG, N_NE_ATOMS, NT
+      REAL(q) :: DELTA_NELECT, ZVAL_NE_CURRENT
+      IF (.NOT. INIT_DONE_24) CALL FAIL_IPI("CHGDATA requires constant-potential INIT.")
+      ! IBRION=24 CHGDATA always carries target total NELECT plus an
+      ! int32 mode_flags bitmask.
+      IF (COMM%NODE_ME == 1) THEN
+        CALL readbuffer(SOCKET, INFO%NELECT)
+        CALL readbuffer(SOCKET, IPI_MODE_FLAGS)
+      ENDIF
+      CALL M_bcast_d(COMM,INFO%NELECT,1)
+      CALL M_bcast_i(COMM, IPI_MODE_FLAGS, 1)
+
+      IF (IPI_MODE_FLAGS/=0 .AND. IPI_MODE_FLAGS/=2) THEN
+        IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) THEN
+          WRITE(IO%IU0,*) 'ERROR: Unsupported i-PI CHGDATA mode_flags value: ', IPI_MODE_FLAGS
+        ENDIF
+        CALL FAIL_IPI("Invalid i-PI request or force result.")
+      ENDIF
+      IF (.NOT. IEEE_IS_FINITE(INFO%NELECT) .OR. INFO%NELECT<=0._q) THEN
+        IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) &
+     &          WRITE(IO%IU0,*) 'ERROR: CHGDATA requires a finite positive electron number.'
+        CALL FAIL_IPI("Invalid i-PI request or force result.")
+      ENDIF
+
+      NE_DOPING_FLAG = IAND(IPI_MODE_FLAGS,2)
+      IF (NE_DOPING_FLAG/=0) THEN
+        IF (NEUTRAL_ELECTRONS_REF<=0._q) THEN
+          IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) THEN
+            WRITE(IO%IU0,*) 'ERROR: Ne-electrode CHGDATA requires neutral_electrons from INIT.'
+          ENDIF
+          CALL FAIL_IPI("Invalid i-PI request or force result.")
+        ENDIF
+        IF (NE_SPECIES_TYPE<=0) THEN
+          DO NT=1,T_INFO%NTYP
+            IF (TRIM(ADJUSTL(P(NT)%ELEMENT))=='Ne' .OR. TRIM(ADJUSTL(P(NT)%ELEMENT))=='NE') THEN
+              NE_SPECIES_TYPE = NT
+              EXIT
+            ENDIF
+          ENDDO
+        ENDIF
+        IF (NE_SPECIES_TYPE<=0) THEN
+          IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) THEN
+            WRITE(IO%IU0,*) 'ERROR: Ne-electrode CHGDATA requested but no Ne species was found in POTCAR.'
+          ENDIF
+          CALL FAIL_IPI("Invalid i-PI request or force result.")
+        ENDIF
+        N_NE_ATOMS = T_INFO%NITYP(NE_SPECIES_TYPE)
+        IF (N_NE_ATOMS<=0) THEN
+          IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) THEN
+            WRITE(IO%IU0,*) 'ERROR: Ne-electrode CHGDATA requested but no Ne ions are present in POSCAR.'
+          ENDIF
+          CALL FAIL_IPI("Invalid i-PI request or force result.")
+        ENDIF
+
+        DELTA_NELECT = INFO%NELECT - NEUTRAL_ELECTRONS_REF
+        ZVAL_NE_CURRENT = P(NE_SPECIES_TYPE)%ZVALF_ORIG + &
+     &                          DELTA_NELECT/REAL(N_NE_ATOMS,q)
+        P(NE_SPECIES_TYPE)%ZVALF      = ZVAL_NE_CURRENT
+        CALL SOL_UPDATE_ZVSUM(T_INFO,P)
+        NE_DOPING_MODE = .TRUE.
+
+        IF (COMM%NODE_ME == 1) THEN
+          WRITE(TIU0,*) ' @ DRIVER MODE: Ne-electrode CHGDATA target NELECT = ', INFO%NELECT, &
+     &                         ', neutral_electrons = ', NEUTRAL_ELECTRONS_REF
+          WRITE(TIU0,*) ' @ DRIVER MODE: Ne atoms = ', N_NE_ATOMS, &
+     &                         ', Ne ZVALF = ', ZVAL_NE_CURRENT
+        ENDIF
+      ELSE
+        IF (NE_DOPING_MODE) THEN
+          IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) &
+     &            WRITE(IO%IU0,*) 'ERROR: Cannot disable Ne-electrode mode after it has started.'
+          CALL FAIL_IPI("Invalid i-PI request or force result.")
+        ENDIF
+        IF (COMM%NODE_ME == 1) &
+     &          WRITE(TIU0,*) ' @ DRIVER MODE: Updated NELECT from CHGDATA: ', INFO%NELECT
+      ENDIF
+      IPI_CHGDATA_READY=.TRUE.
+      IPI_RESULT_VALID=.FALSE.
+      IPI_OBSERVABLES_READY=.FALSE.
+      HASDATA=.FALSE.
+      END SUBROUTINE READ_IPI_CHARGE
+
+      SUBROUTINE PREPARE_IPI_OBSERVABLES
+      LOGICAL :: LIPI_POTENTIAL_AVERAGE, LIPI_HARTREE_ONLY
+      LOGICAL :: LDO_SOL_SAVE, LCOR_DIP_SAVE
+      TYPE(energy) :: IPI_ENERGY_SAVE
+      REAL(q) :: VAC_LEVEL_EV, WORKFUNCTION_EV
+      IF (.NOT. IPI_RESULT_VALID) CALL FAIL_IPI("GETFORCE requires a completed constant-potential SCF.")
+      IF (IPI_OBSERVABLES_READY) RETURN
+      LIPI_POTENTIAL_AVERAGE = (POTENTIAL_AVERAGE_MAX_A>POTENTIAL_AVERAGE_MIN_A)
+      LIPI_HARTREE_ONLY = (IO%LVHAR .OR. LIPI_POTENTIAL_AVERAGE)
+      IF (IO%LVTOT.OR.IO%LVHAR .OR. LIPI_POTENTIAL_AVERAGE) THEN
+#ifdef MPI
+        IF (WDES%COMM_KINTER%NODE_ME.EQ.1) THEN
+#endif
+          IF (LIPI_HARTREE_ONLY) THEN
+            CALL PUSH_LEXCH(-1)
+          ENDIF
+          IPI_ENERGY_SAVE = E
+          LDO_SOL_SAVE = LDO_SOL
+          ! Output uses the converged solvent state and cannot refresh it.
+          LDO_SOL = .FALSE.
+          CALL POTLOK(GRID,GRIDC,GRID_SOFT, WDES%COMM_INTER, WDES, &
+     &                     INFO,P,T_INFO,E,LATT_CUR, &
+     &                     CHTOT,CSTRF,CVTOT,DENCOR,SV, SOFT_TO_C,XCSIF)
+
+          IF (.NOT. LIPI_HARTREE_ONLY) THEN
+            CALL POTLOK_METAGGA(KINEDEN, &
+     &                   GRID,GRIDC,GRID_SOFT,WDES%COMM_INTER,WDES,INFO,P,T_INFO,E,LATT_CUR, &
+     &                   CHDEN,CHTOT,DENCOR,CVTOT,SV,HAMILTONIAN%MUTOT,HAMILTONIAN%MU,SOFT_TO_C,XCSIF)
+          ENDIF
+
+          IF (LIPI_HARTREE_ONLY) THEN
+            CALL POP_LEXCH
+          ENDIF
+
+          IF ( DIP%IDIPCO >0 ) THEN
+            LCOR_DIP_SAVE = DIP%LCOR_DIP
+            DIP%LCOR_DIP=.FALSE.
+            CALL CDIPOL_CHTOT_REC(GRIDC, LATT_CUR,P,T_INFO, &
+     &                CHTOT,CSTRF,CVTOT, WDES%NCDIJ, INFO%NELECT, E%PSCENC )
+            DIP%LCOR_DIP = LCOR_DIP_SAVE
+
+            CALL WRITE_VACUUM_LEVEL(IO%IU6)
+          ENDIF
+
+!               Use the current electrostatic potential for every configuration.
+          IF (LIPI_POTENTIAL_AVERAGE) THEN
+            CALL POTENTIAL_AVERAGE_FROM_CVTOT(GRIDC, LATT_CUR, CVTOT, &
+     &                 POTENTIAL_AVERAGE_AXIS, POTENTIAL_AVERAGE_MIN_A, &
+     &                 POTENTIAL_AVERAGE_MAX_A, VAC_LEVEL_EV)
+          ENDIF
+          E = IPI_ENERGY_SAVE
+          LDO_SOL = LDO_SOL_SAVE
+#ifdef MPI
+        ENDIF
+#endif
+      ENDIF
+      IF (.NOT. IEEE_IS_FINITE(EFERMI)) THEN
+        IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) &
+     &          WRITE(IO%IU0,*) 'ERROR: VASP returned a non-finite Fermi level.'
+        CALL FAIL_IPI("Invalid i-PI request or force result.")
+      ENDIF
+      IF (.NOT. IEEE_IS_FINITE(INFO%NELECT) .OR. INFO%NELECT<=0._q) THEN
+        IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) &
+     &          WRITE(IO%IU0,*) 'ERROR: VASP returned an invalid electron number.'
+        CALL FAIL_IPI("Invalid i-PI request or force result.")
+      ENDIF
+      IPI_FERMI_EV = EFERMI
+      IPI_NELECT   = INFO%NELECT
+      IF (POTENTIAL_AVERAGE_MAX_A>POTENTIAL_AVERAGE_MIN_A) THEN
+#ifdef MPI
+        CALL M_bcast_d(COMM,VAC_LEVEL_EV,1)
+#endif
+        IF (.NOT. IEEE_IS_FINITE(VAC_LEVEL_EV)) THEN
+          IF (COMM%NODE_ME == 1 .AND. IO%IU0>=0) &
+   &              WRITE(IO%IU0,*) 'ERROR: VASP returned a non-finite vacuum level.'
+          CALL FAIL_IPI("Invalid i-PI request or force result.")
+        ENDIF
+        IPI_VAC_LEVEL_EV = VAC_LEVEL_EV
+        IPI_WORKFUNCTION_VALID = .TRUE.
+        WORKFUNCTION_EV = IPI_VAC_LEVEL_EV - IPI_FERMI_EV
+        IPI_WORKFUNCTION_EV = WORKFUNCTION_EV
+      ENDIF
+      IPI_OBSERVABLES_READY=.TRUE.
+      END SUBROUTINE PREPARE_IPI_OBSERVABLES
+
+      SUBROUTINE PARSE_IPI_REAL_TOKEN(INPUT_STRING,TOKEN,VALUE,FOUND,OK)
+      CHARACTER(LEN=*), INTENT(IN) :: INPUT_STRING, TOKEN
+      REAL(q), INTENT(OUT) :: VALUE
+      LOGICAL, INTENT(OUT) :: FOUND, OK
+      INTEGER :: TOKEN_POS, COLON_POS, START_POS, END_POS, IOS
+
+      VALUE = 0._q
+      FOUND = .FALSE.
+      OK = .TRUE.
+      TOKEN_POS = INDEX(INPUT_STRING,TRIM(TOKEN))
+      IF (TOKEN_POS<=0) RETURN
+
+      COLON_POS = INDEX(INPUT_STRING(TOKEN_POS:),':')
+      IF (COLON_POS<=0) THEN
+        OK = .FALSE.
+        RETURN
+      ENDIF
+      START_POS = TOKEN_POS + COLON_POS
+      DO WHILE (START_POS<=LEN_TRIM(INPUT_STRING))
+        IF (INPUT_STRING(START_POS:START_POS)/=' ' .AND. &
+     &      INPUT_STRING(START_POS:START_POS)/=',' .AND. &
+     &      INPUT_STRING(START_POS:START_POS)/=';') EXIT
+        START_POS = START_POS + 1
+      ENDDO
+      IF (START_POS>LEN_TRIM(INPUT_STRING)) THEN
+        OK = .FALSE.
+        RETURN
+      ENDIF
+
+      END_POS = START_POS
+      DO WHILE (END_POS<=LEN_TRIM(INPUT_STRING))
+        IF (INPUT_STRING(END_POS:END_POS)==',' .OR. &
+     &      INPUT_STRING(END_POS:END_POS)==';') EXIT
+        END_POS = END_POS + 1
+      ENDDO
+      READ(INPUT_STRING(START_POS:END_POS-1),*,IOSTAT=IOS) VALUE
+      IF (IOS/=0) THEN
+        OK = .FALSE.
+        RETURN
+      ENDIF
+      IF (.NOT. IEEE_IS_FINITE(VALUE)) THEN
+        OK = .FALSE.
+        RETURN
+      ENDIF
+      FOUND = .TRUE.
+      END SUBROUTINE PARSE_IPI_REAL_TOKEN
+
+      SUBROUTINE PARSE_IPI_AXIS_TOKEN(INPUT_STRING,TOKEN,AXIS,FOUND,OK)
+      CHARACTER(LEN=*), INTENT(IN) :: INPUT_STRING, TOKEN
+      INTEGER, INTENT(OUT) :: AXIS
+      LOGICAL, INTENT(OUT) :: FOUND, OK
+      INTEGER :: TOKEN_POS, COLON_POS, START_POS
+
+      FOUND = .FALSE.
+      OK = .TRUE.
+      AXIS = 0
+      TOKEN_POS = INDEX(INPUT_STRING,TRIM(TOKEN))
+      IF (TOKEN_POS<=0) RETURN
+      COLON_POS = INDEX(INPUT_STRING(TOKEN_POS:),':')
+      IF (COLON_POS<=0) THEN
+        OK = .FALSE.
+        RETURN
+      ENDIF
+      START_POS = TOKEN_POS + COLON_POS
+      DO WHILE (START_POS<=LEN_TRIM(INPUT_STRING))
+        IF (INPUT_STRING(START_POS:START_POS)/=' ' .AND. &
+     &      INPUT_STRING(START_POS:START_POS)/=',' .AND. &
+     &      INPUT_STRING(START_POS:START_POS)/=';') EXIT
+        START_POS = START_POS + 1
+      ENDDO
+      IF (START_POS>LEN_TRIM(INPUT_STRING)) THEN
+        OK = .FALSE.
+        RETURN
+      ENDIF
+      SELECT CASE (INPUT_STRING(START_POS:START_POS))
+      CASE ('x','X')
+        AXIS = 1
+      CASE ('y','Y')
+        AXIS = 2
+      CASE ('z','Z')
+        AXIS = 3
+      CASE DEFAULT
+        OK = .FALSE.
+        RETURN
+      END SELECT
+      FOUND = .TRUE.
+      END SUBROUTINE PARSE_IPI_AXIS_TOKEN
+
 
