+     &        WRITE(IO%IU0,*) 'ERROR: Malformed or incomplete constant-potential INIT payload.'
+        CALL FAIL_IPI("Invalid i-PI request or force result.")
+      ENDIF
+      CALL M_bcast_d(COMM,INFO%NELECT,1)
+      CALL M_bcast_d(COMM,NEUTRAL_ELECTRONS_REF,1)
+      CALL M_bcast_i(COMM,POTENTIAL_AVERAGE_AXIS,1)
+      CALL M_bcast_d(COMM,POTENTIAL_AVERAGE_MIN_A,1)
+      CALL M_bcast_d(COMM,POTENTIAL_AVERAGE_MAX_A,1)
+
+      IF (COMM%NODE_ME == 1) &
+     &      WRITE(TIU0,*) ' @ DRIVER MODE: VASPsol switches LSOL/LSOL_SCF: ', LSOL, LSOL_SCF
+      CALL SOL_RESET_DRIVER
+      INIT_DONE_24 = .TRUE.
+      HASDATA=.FALSE.
