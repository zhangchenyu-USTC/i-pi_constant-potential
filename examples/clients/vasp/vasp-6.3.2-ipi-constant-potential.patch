+            LATT_CUR%B(NI,1) = CELL_IH(NI*3-2)/AUTOA
+            LATT_CUR%B(NI,2) = CELL_IH(NI*3-1)/AUTOA
+            LATT_CUR%B(NI,3) = CELL_IH(NI*3)/AUTOA
