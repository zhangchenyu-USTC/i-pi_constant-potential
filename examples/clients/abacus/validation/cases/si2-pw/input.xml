<simulation verbosity="medium">
  <prng><seed>51723</seed></prng>
  <output prefix="cp">
    <properties stride="1" filename="out">[ step, potential{electronvolt}, electronic_charge,
      fermi_level{electronvolt}, workfunction{electronvolt}, Grand_canonical_potential{electronvolt}
       ]</properties>
    <trajectory filename="pos" stride="1" format="xyz">positions{atomic_unit}</trajectory>
    <checkpoint stride="1" filename="checkpoint" overwrite="true" />
  </output>
  <total_steps>10</total_steps>
  <ffsocket name="abacus" mode="unix">
    <address>abacus_cp_example</address><timeout>120</timeout><latency>0.01</latency>
    <batch_size>1</batch_size><consolidate_messages>true</consolidate_messages>
  </ffsocket>
  <system>
    <initialize nbeads="1">
      <file mode="xyz" units="atomic_unit">init.xyz</file>
      <cell mode="abc" units="atomic_unit">[10.26, 10.26, 10.26]</cell>
      <velocities mode="thermal" units="kelvin">10</velocities>
    </initialize>
    <forces><force forcefield="abacus" /></forces>
    <ensemble><temperature units="kelvin">10</temperature></ensemble>
    <motion mode="dynamics"><fixcom>false</fixcom>
      <dynamics mode="nvt" splitting="baoab">
        <timestep units="femtosecond">0.1</timestep><thermostat mode="langevin"><tau units="femtosecond">50</tau></thermostat>
        <electrons enabled="true" charge_mixing="false">
          <target_workfunction units="electronvolt">4.0</target_workfunction><potential_average_axis>z</potential_average_axis><potential_average_region units="angstrom">[2, 4]</potential_average_region>
          <neutral_electrons>8</neutral_electrons><q_init>8.05</q_init>
          <mass units="dalton">50</mass>
          <potentiostat mode="langevin"><tau units="femtosecond">300</tau></potentiostat>
        </electrons>
      </dynamics>
    </motion>
  </system>
</simulation>