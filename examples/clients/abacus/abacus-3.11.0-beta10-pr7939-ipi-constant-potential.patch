@@ -0,0 +1,37 @@
+#ifndef ABACUS_SOCKET_CONSTANT_POTENTIAL_H
+#define ABACUS_SOCKET_CONSTANT_POTENTIAL_H
+
+#include "source_esolver/electronic_control.h"
+#include <string>
+
+class Parameter;
