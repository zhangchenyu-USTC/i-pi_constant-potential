    CHARACTER(len=*), PARAMETER, PRIVATE :: moduleN = 'ipi_driver'
 
+   ! Unit conversion constants
+   REAL(KIND=dp), PARAMETER :: HARTREE_TO_EV = 27.211386245988_dp
+   INTEGER(KIND=int_4), PARAMETER :: IPI_FLAG_NE_ELECTRODE = 2_int_4
