+
+            needed_mos = 0
+            IF (nelectron_spin(ispin) > 0) THEN
+               needed_mos = CEILING(REAL(nelectron_spin(ispin), KIND=dp)/maxocc - 1.0e-12_dp)
+            END IF
+            IF (needed_mos > nmo) THEN
+               CPABORT("CP2K CHGDATA update needs more MOs. Increase ADDED_MOS in the CP2K input.")
+            END IF
+
+            CALL set_mo_set(mos(ispin), nelectron=nelectron_spin(ispin), &
+                            n_el_f=REAL(nelectron_spin(ispin), KIND=dp))
+
+            IF (ASSOCIATED(occupation_numbers)) THEN
+               occupation_numbers(:) = 0.0_dp
+               remaining_occ = REAL(nelectron_spin(ispin), KIND=dp)
+               ifill = 0
+               DO WHILE (remaining_occ > maxocc - 1.0e-12_dp)
+                  ifill = ifill + 1
+                  occupation_numbers(ifill) = maxocc
+                  remaining_occ = remaining_occ - maxocc
+               END DO
+
+               IF (remaining_occ > 1.0e-12_dp) THEN
+                  ifill = ifill + 1
+                  occupation_numbers(ifill) = remaining_occ
+               END IF
+
+               homo = ifill
+               lfomo = MIN(homo + 1, nmo)
+               CALL set_mo_set(mos(ispin), homo=homo, lfomo=lfomo)
+            END IF
+         END DO
+      END IF
+
+      IF (ASSOCIATED(ks_env)) THEN
+         CALL set_ks_env(ks_env, potential_changed=.TRUE., &
+                         forces_up_to_date=.FALSE.)
+      END IF
+
+      CALL timestop(handle)
+
+   END SUBROUTINE apply_cp2k_nelect
+
+! **************************************************************************************************
+!> \brief Reinitialize the native QS electronic state for a changed ordinary OT count.
+!> Retain the current nuclear subsystem and cells while replacing all electronic
+!> state. The force environment, socket, MPI environment and original input remain
+!> alive. A private FORCE_EVAL copy carries the new charge and a guess suitable
+!> for the new occupied space. Atomic and old-wavefunction guesses use CORE.
+! **************************************************************************************************
+   SUBROUTINE rebuild_ordinary_ot_qs(force_env, new_charge, target_nelect)
+      TYPE(force_env_type), POINTER                      :: force_env
+      INTEGER, INTENT(IN)                                :: new_charge, target_nelect
+
+      INTEGER                                            :: density_guess, output_unit
+      LOGICAL                                            :: use_ref_cell
+      TYPE(cell_type), POINTER                           :: held_cell, held_ref_cell
+      TYPE(cp_subsys_type), POINTER                      :: held_subsys
+      TYPE(global_environment_type), POINTER             :: globenv
+      TYPE(mp_para_env_type), POINTER                    :: para_env
+      TYPE(qs_environment_type), POINTER                 :: qs_env
+      TYPE(section_vals_type), POINTER                   :: old_input, new_input, subsys_section
+
+      NULLIFY (qs_env, held_subsys, held_cell, held_ref_cell, old_input, new_input, subsys_section)
+      CALL force_env_get(force_env, qs_env=qs_env, para_env=para_env, globenv=globenv)
+      CALL get_qs_env(qs_env, cp_subsys=held_subsys, cell=held_cell, &
+                      cell_ref=held_ref_cell, use_ref_cell=use_ref_cell, input=old_input)
+      CPASSERT(ASSOCIATED(held_subsys))
+      CPASSERT(ASSOCIATED(held_cell))
+      CALL cp_subsys_retain(held_subsys)
+      CALL cell_retain(held_cell)
+      IF (use_ref_cell) THEN
+         CPASSERT(ASSOCIATED(held_ref_cell))
+         CALL cell_retain(held_ref_cell)
+      END IF
+
+      CALL section_vals_duplicate(old_input, new_input)
+      CALL section_vals_val_set(new_input, "DFT%CHARGE", i_val=new_charge)
+      CALL section_vals_val_get(new_input, "DFT%SCF%SCF_GUESS", i_val=density_guess)
+      SELECT CASE (density_guess)
+      CASE (atomic_guess, restart_guess, history_guess)
+         ! Atomic densities can lack rank for newly occupied MOs; restart files
+         ! and their history belong to the previous occupied space. CORE builds
+         ! a complete fresh MO basis using the new charge and occupations.
+         CALL section_vals_val_set(new_input, "DFT%SCF%SCF_GUESS", i_val=core_guess)
+      END SELECT
+      subsys_section => section_vals_get_subs_vals(new_input, "SUBSYS")
+
+      ! Keep the QS object itself, so the force-environment registry stays valid.
+      ! All children are released and rebuilt through the normal initialization.
+      CALL qs_env_release(qs_env)
+      CALL qs_env_create(qs_env, globenv=globenv)
+      IF (use_ref_cell) THEN
+         CALL qs_init(qs_env, para_env, root_section=force_env%root_section, globenv=globenv, &
+                      cp_subsys=held_subsys, cell=held_cell, cell_ref=held_ref_cell, &
+                      force_env_section=new_input, subsys_section=subsys_section, &
+                      use_motion_section=.FALSE., silent=.TRUE.)
+         CALL cell_release(held_ref_cell)
+      ELSE
+         CALL qs_init(qs_env, para_env, root_section=force_env%root_section, globenv=globenv, &
+                      cp_subsys=held_subsys, cell=held_cell, &
+                      force_env_section=new_input, subsys_section=subsys_section, &
+                      use_motion_section=.FALSE., silent=.TRUE.)
+      END IF
+      CALL force_env_set(force_env, force_env_section=new_input)
+      CALL section_vals_release(new_input)
+      CALL cell_release(held_cell)
+      CALL cp_subsys_release(held_subsys)
+
+      output_unit = cp_logger_get_default_io_unit()
+      IF (output_unit > 0) WRITE (output_unit, '(A,I0)') &
+         " @ DRIVER MODE: ordinary OT electronic state rebuilt for NELECT=", target_nelect
+   END SUBROUTINE rebuild_ordinary_ot_qs
+
+! **************************************************************************************************
+!> \brief   Apply Ne core correction update from i-PI total electron number.
+!>
+!> Receives the target total electron number and converts it to a per-Ne core
+!> correction using core_corr_ne = (target_nelect - neutral_electrons_ref)/N_ne.
+!> It applies the resulting value to all Ne atomic kinds in the QS subsystem by
+!> updating the underlying all-electron or GTH/SGP potential zeff_correction
+!> field. This effectively corresponds to adjusting the CORE_CORRECTION keyword
+!> for Ne.
+!>
+!> The implementation traverses the QS environment, obtains the atomic kind
+!> and QS kind arrays, and for each kind whose element symbol is 'Ne' it
+!> updates zeff_correction := core_corr_ne and keeps the associated effective
+!> charge parameters consistent with a statically parsed CORE_CORRECTION input.
+!> The resulting change is reflected in the subsequent charge and electron
+!> counts through the existing zeff_correction usage in QS routines.
+! **************************************************************************************************
+   SUBROUTINE apply_ne_core_correction(force_env, target_nelect, neutral_electrons_ref)
+
+      TYPE(force_env_type), POINTER                      :: force_env
+      REAL(KIND=dp), INTENT(IN)                          :: target_nelect, neutral_electrons_ref
+
+      CHARACTER(LEN=*), PARAMETER :: routineN = 'apply_ne_core_correction'
+      REAL(KIND=dp), PARAMETER :: core_corr_refresh_tol = 1.0e-12_dp
+
+      CHARACTER(LEN=2)                                   :: elem
+      INTEGER                                            :: handle, ikind, iparticle, n_ne_atoms, &
+                                                            nkind, output_unit, neutral_nelect, nmo
+      LOGICAL                                            :: core_corr_changed, found_ne, do_kpoints
+      REAL(KIND=dp)                                      :: base_zeff, core_corr_ne, delta_q, &
+                                                            new_zeff, old_zeff, zeff_scale, maxocc, kind_corr
+      TYPE(all_potential_type), POINTER                  :: all_potential
+      TYPE(atomic_kind_type), DIMENSION(:), POINTER      :: atomic_kind_set
+      TYPE(atomic_kind_type), POINTER                    :: atomic_kind
+      TYPE(cp_subsys_type), POINTER                      :: cp_subsys
+      TYPE(dft_control_type), POINTER                    :: dft_control
+      TYPE(gth_potential_type), POINTER                  :: gth_potential
+      TYPE(qs_environment_type), POINTER                 :: qs_env
+      TYPE(qs_kind_type), DIMENSION(:), POINTER          :: qs_kind_set
+      TYPE(qs_kind_type), POINTER                        :: qs_kind
+      TYPE(qs_ks_env_type), POINTER                      :: ks_env
+      TYPE(mo_set_type), DIMENSION(:), POINTER           :: mos
+      TYPE(scf_control_type), POINTER                    :: scf_control
+      TYPE(sgp_potential_type), POINTER                  :: sgp_potential
+
+      CALL timeset(routineN, handle)
+
+      IF (.NOT. IEEE_IS_FINITE(target_nelect) .OR. target_nelect <= 0.0_dp) THEN
+         CPABORT("CHGDATA Ne-electrode mode requires a finite positive target electron number.")
+      END IF
+      IF (.NOT. IEEE_IS_FINITE(neutral_electrons_ref) .OR. neutral_electrons_ref <= 0.0_dp) THEN
+         CPABORT("CHGDATA Ne-electrode mode requires neutral_electrons from INIT.")
+      END IF
+
+      ! Obtain QS environment and atomic kind / kind sets. If this is not a
+      ! QS calculation there is nothing to do.
+      NULLIFY (qs_env)
+      CALL force_env_get(force_env, qs_env=qs_env)
+      IF (.NOT. ASSOCIATED(qs_env)) THEN
+         CPABORT("CHGDATA Ne core correction requires a QS force environment.")
+      END IF
+
+      NULLIFY (cp_subsys)
+      CALL force_env_get(force_env, subsys=cp_subsys)
+      IF (.NOT. ASSOCIATED(cp_subsys)) THEN
+         CPABORT("CHGDATA Ne core correction could not access CP2K subsystem.")
+      END IF
+
+      NULLIFY (atomic_kind_set)
+      NULLIFY (qs_kind_set)
+      NULLIFY (ks_env)
+      NULLIFY (dft_control, scf_control, mos)
+      CALL get_qs_env(qs_env=qs_env, atomic_kind_set=atomic_kind_set, &
+                      qs_kind_set=qs_kind_set, ks_env=ks_env, dft_control=dft_control, &
+                      scf_control=scf_control, mos=mos, do_kpoints=do_kpoints)
+
+      IF (.NOT. (ASSOCIATED(atomic_kind_set) .AND. ASSOCIATED(qs_kind_set))) THEN
+         CPABORT("CHGDATA Ne core correction could not access CP2K kind sets.")
+      END IF
+      IF (.NOT. ASSOCIATED(dft_control) .OR. .NOT. ASSOCIATED(scf_control)) &
+         CPABORT("CP2K Ne CHGDATA requires DFT and SCF controls.")
+      IF (do_kpoints) CPABORT("CP2K Ne CHGDATA supports the Gamma pathway without explicit KPOINTS only.")
+      IF (dft_control%nspins /= 1 .OR. dft_control%roks .OR. dft_control%low_spin_roks) &
+         CPABORT("CP2K Ne CHGDATA currently requires RKS (one spin channel).")
+      IF (.NOT. dft_control%correct_surf_dip .OR. .NOT. dft_control%correct_el_density_dip) &
+         CPABORT("CP2K Ne CHGDATA requires SURFACE_DIPOLE_CORRECTION TRUE and CORE_CORR_DIP TRUE.")
+      IF (scf_control%use_ot .OR. .NOT. scf_control%use_diag .OR. &
+          scf_control%diagonalization%method /= diag_standard .OR. scf_control%non_selfconsistent .OR. &
+          scf_control%max_scf <= 0) &
+         CPABORT("CP2K Ne CHGDATA requires self-consistent DIAGONALIZATION ALGORITHM STANDARD.")
+      IF (scf_control%diagonalization%mom .OR. dft_control%hairy_probes .OR. &
+          dft_control%do_xas_calculation .OR. dft_control%do_xas_tdp_calculation) &
+         CPABORT("CP2K Ne CHGDATA does not support MOM, HAIRY_PROBES or XAS occupations.")
+      IF (dft_control%charge /= 0) CPABORT("CP2K Ne CHGDATA requires DFT CHARGE 0.")
+      CALL get_qs_kind_set(qs_kind_set, nelectron=neutral_nelect)
+      IF (ABS(REAL(neutral_nelect, dp) - neutral_electrons_ref) > ELECTRON_COUNT_TOL) &
+         CPABORT("CP2K Ne INIT neutral_electrons differs from the base valence count.")
+      IF (.NOT. ASSOCIATED(mos)) CPABORT("CP2K Ne CHGDATA requires allocated MO sets.")
+      IF (SIZE(mos) /= 1) CPABORT("CP2K Ne CHGDATA requires exactly one MO set.")
+      IF (mos(1)%nelectron /= neutral_nelect) &
+         CPABORT("CP2K Ne CHGDATA found an inconsistent base MO electron count.")
+      CALL get_mo_set(mos(1), nmo=nmo, maxocc=maxocc)
+      IF (nmo <= 0 .OR. maxocc /= 2.0_dp) CPABORT("CP2K Ne CHGDATA requires allocated RKS orbitals.")
+      IF (target_nelect > maxocc*REAL(nmo, dp)) &
+         CPABORT("CP2K Ne CHGDATA exceeds the MO capacity; increase ADDED_MOS.")
+      IF (.NOT. ASSOCIATED(scf_control%smear)) CPABORT("CP2K Ne CHGDATA could not access smearing controls.")
+      IF (scf_control%smear%do_smear) THEN
+         IF (scf_control%smear%method /= smear_fermi_dirac) &
+            CPABORT("CP2K Ne CHGDATA supports FERMI_DIRAC smearing or no smearing only.")
+         IF (.NOT. IEEE_IS_FINITE(scf_control%smear%electronic_temperature) .OR. &
+             scf_control%smear%electronic_temperature <= 0.0_dp) &
+            CPABORT("CP2K Ne FERMI_DIRAC smearing requires a finite positive ELECTRONIC_TEMPERATURE.")
+         IF (target_nelect >= maxocc*REAL(nmo, dp)) &
+            CPABORT("CP2K Ne FERMI_DIRAC smearing requires empty orbitals; increase ADDED_MOS.")
+      END IF
+
+      ! Reject offsets not represented by the INIT neutral reference before
+      ! modifying any Ne potential. Existing Ne corrections are overwritten.
+      DO ikind = 1, SIZE(atomic_kind_set)
+         elem = ADJUSTL(atomic_kind_set(ikind)%element_symbol)
+         IF (TRIM(elem) == 'Ne' .OR. TRIM(elem) == 'NE') CYCLE
+         NULLIFY (all_potential, gth_potential, sgp_potential)
+         qs_kind => qs_kind_set(ikind)
+         CALL get_qs_kind(qs_kind, all_potential=all_potential, &
+                          gth_potential=gth_potential, sgp_potential=sgp_potential)
+         kind_corr = 0.0_dp
+         IF (ASSOCIATED(all_potential)) kind_corr = all_potential%zeff_correction
+         IF (ASSOCIATED(gth_potential)) kind_corr = gth_potential%zeff_correction
+         IF (ASSOCIATED(sgp_potential)) kind_corr = sgp_potential%zeff_correction
+         IF (kind_corr /= 0.0_dp) CPABORT("CP2K Ne CHGDATA requires zero CORE_CORRECTION on non-Ne kinds.")
+      END DO
+
+      nkind = SIZE(atomic_kind_set, 1)
+      found_ne = .FALSE.
+      core_corr_changed = .FALSE.
+      n_ne_atoms = 0
+
+      DO iparticle = 1, cp_subsys%particles%n_els
+         atomic_kind => cp_subsys%particles%els(iparticle)%atomic_kind
+         IF (ASSOCIATED(atomic_kind)) THEN
+            elem = atomic_kind%element_symbol
+            elem = ADJUSTL(elem)
+            IF (TRIM(elem) == 'Ne' .OR. TRIM(elem) == 'NE') THEN
+               n_ne_atoms = n_ne_atoms + 1
+            END IF
+         END IF
+      END DO
+
+      IF (n_ne_atoms <= 0) THEN
+         CPABORT("CHGDATA Ne-electrode mode requested but no Ne atoms were found.")
+      END IF
+
+      delta_q = target_nelect - neutral_electrons_ref
+      core_corr_ne = delta_q/REAL(n_ne_atoms, KIND=dp)
+
+      DO ikind = 1, nkind
+         atomic_kind => atomic_kind_set(ikind)
+         qs_kind => qs_kind_set(ikind)
+
+         ! Identify Ne atomic kinds by their element symbol. Compare against
+         ! the canonical two-character symbol "Ne" (and its fully uppercase
+         ! variant) after left adjustment.
+         elem = atomic_kind%element_symbol
+         elem = ADJUSTL(elem)
+
+         IF (TRIM(elem) == 'Ne' .OR. TRIM(elem) == 'NE') THEN
+            found_ne = .TRUE.
+            NULLIFY (all_potential)
+            NULLIFY (gth_potential)
+            NULLIFY (sgp_potential)
+
+            CALL get_qs_kind(qs_kind, all_potential=all_potential, gth_potential=gth_potential, &
+                             sgp_potential=sgp_potential)
+
+            IF (ASSOCIATED(all_potential)) THEN
+               IF (ABS(all_potential%zeff_correction - core_corr_ne) > core_corr_refresh_tol) THEN
+                  old_zeff = all_potential%zeff
+                  base_zeff = old_zeff - all_potential%zeff_correction
+                  new_zeff = base_zeff + core_corr_ne
+                  IF (ABS(old_zeff) > EPSILON(1.0_dp)) THEN
+                     zeff_scale = new_zeff/old_zeff
+                     all_potential%ccore_charge = all_potential%ccore_charge*zeff_scale
+                  END IF
+                  all_potential%zeff = new_zeff
+                  all_potential%zeff_correction = core_corr_ne
+                  core_corr_changed = .TRUE.
+               END IF
+            END IF
+            IF (ASSOCIATED(gth_potential)) THEN
+               IF (ABS(gth_potential%zeff_correction - core_corr_ne) > core_corr_refresh_tol) THEN
+                  old_zeff = gth_potential%zeff
+                  base_zeff = old_zeff - gth_potential%zeff_correction
+                  new_zeff = base_zeff + core_corr_ne
+                  IF (ABS(old_zeff) > EPSILON(1.0_dp)) THEN
+                     zeff_scale = new_zeff/old_zeff
+                     gth_potential%ccore_charge = gth_potential%ccore_charge*zeff_scale
+                     gth_potential%cerf_ppl = gth_potential%cerf_ppl*zeff_scale
+                  END IF
+                  gth_potential%zeff = new_zeff
+                  gth_potential%zeff_correction = core_corr_ne
+                  core_corr_changed = .TRUE.
+               END IF
+            END IF
+            IF (ASSOCIATED(sgp_potential)) THEN
+               IF (ABS(sgp_potential%zeff_correction - core_corr_ne) > core_corr_refresh_tol) THEN
+                  old_zeff = sgp_potential%zeff
+                  base_zeff = old_zeff - sgp_potential%zeff_correction
+                  new_zeff = base_zeff + core_corr_ne
+                  IF (ABS(old_zeff) > EPSILON(1.0_dp)) THEN
+                     zeff_scale = new_zeff/old_zeff
+                     sgp_potential%ccore_charge = sgp_potential%ccore_charge*zeff_scale
+                  END IF
+                  sgp_potential%zeff = new_zeff
+                  sgp_potential%zeff_correction = core_corr_ne
+                  core_corr_changed = .TRUE.
+               END IF
+            END IF
+         END IF
+      END DO
+
+      IF (.NOT. found_ne) THEN
+         CPABORT("CHGDATA Ne core correction requested but no Ne atomic kind was found.")
+      END IF
+
+      output_unit = cp_logger_get_default_io_unit()
+      IF (output_unit > 0) THEN
+         WRITE (output_unit, *) " @ DRIVER MODE: Ne-electrode CHGDATA target_nelect = ", target_nelect, &
+            " neutral_electrons = ", neutral_electrons_ref
+         WRITE (output_unit, *) " @ DRIVER MODE: Ne atoms = ", n_ne_atoms, &
+            " CORE_CORRECTION per Ne = ", core_corr_ne
+         IF (.NOT. core_corr_changed) THEN
+            WRITE (output_unit, *) " @ DRIVER MODE: Ne CORE_CORRECTION refresh skipped; change <= ", &
+               core_corr_refresh_tol
+         END IF
+      END IF
+
+      IF (core_corr_changed) THEN
+         CALL get_qs_kind_set(qs_kind_set, total_zeff_corr=qs_env%total_zeff_corr)
+      END IF
+      IF (ABS(REAL(neutral_nelect, dp) + qs_env%total_zeff_corr - target_nelect) > ELECTRON_COUNT_TOL) &
+         CPABORT("CP2K Ne applied core correction does not match the requested electron number.")
+
+      IF (core_corr_changed .AND. ASSOCIATED(ks_env)) THEN
+         CALL set_ks_env(ks_env, potential_changed=.TRUE., &
+                         forces_up_to_date=.FALSE.)
+      END IF
+
+      CALL timestop(handle)
+
+   END SUBROUTINE apply_ne_core_correction
+
 END MODULE ipi_driver
